{
  "expo": {
    "name": "Megurikago",
    "slug": "megurikago",
    "version": "1.0.0",
    "orientation": "portrait",
    "locales": {
      "ja": "./locales/ja.json"
    },
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.niertama.megurikago",
      "infoPlist": {
        "CFBundleDisplayName": "Megurikago",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.niertama.megurikago"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "品の写真を選ぶために使います。",
          "cameraPermission": "品の写真を撮るために使います。",
          "microphonePermission": "話して品を入れるために、マイクを使います。"
        }
      ],
      "expo-secure-store",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "話して品を入れるために、マイクを使います。",
          "speechRecognitionPermission": "話した内容を文字にするために、音声認識を使います。"
        }
      ],
      "@bacons/apple-targets"
    ],
    "scheme": "megurikago"
  }
}
